{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "carito",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Permite usar las librerías de Node.js (por ejemplo, el driver de PostgreSQL más adelante)
    "nodejs_compat",
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "carito",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
